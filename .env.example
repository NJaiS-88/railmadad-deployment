# ==============================================================================
# 🚆 RailMadad 2.0 - Master Environment Configuration Template
# Copy this file to `.env` and fill in your actual credentials.
# ==============================================================================

# ── 1. Backend REST API & Database ────────────────────────────────────────────
PORT=5000
# For local Docker use: mongodb://mongodb:27017/railmadad
# For standalone local use: mongodb://localhost:27017/railmadad
# Or MongoDB Atlas connection URI:
MONGO_URI=mongodb://localhost:27017/railmadad
JWT_SECRET=railmadad_super_secret_jwt_key_production_2026

# Allowed CORS origins (comma-separated or * for all)
CORS_ORIGIN=*

# ── 2. AI Model Credentials ───────────────────────────────────────────────────
# NVIDIA NIM API Key (Powers Nemotron LLM Analysis, Triage & Agent decision making)
NVIDIA_NIM_API_KEY=nvapi-your-nvidia-nim-api-key-here

# OpenRouter API Key (For thinkingmachines/inkling vision model — captioning & ID OCR)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Hugging Face Token (Fallback image/audio transcription)
HF_TOKEN=hf_your_huggingface_token_here

# RailRadar Live Train Tracking API Key
RAILRADAR_API_KEY=rg_your_railradar_api_key_here

# ── 3. Internal Microservice URLs (Used by Backend & Agents) ──────────────────
# Default for standalone / local dev:
ML_SERVICE_URL=http://localhost:8000
CLASSIFICATION_SERVICE_URL=http://localhost:8001
STAFF_SERVICE_URL=http://localhost:8002

# (In Docker Compose, these automatically map to container hostnames:
#  http://ml-service:8000, http://classification-agent:8001, http://staff-assignment-agent:8002)

# ── 4. Twilio Telephony & WhatsApp (Optional) ─────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+19403267863
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Public webhook URL (e.g. your ngrok domain or public production domain)
TWILIO_BASE_URL=https://your-domain.com

# Internal API authentication key
INTERNAL_API_KEY=railmadad-internal-2025

# ── 5. Frontend Build Configuration (Vite) ────────────────────────────────────
# Relative /api and /ml work automatically through Nginx Gateway
VITE_API_URL=/api
VITE_ML_URL=/ml
VITE_ML_SERVICE_URL=/api/complaints

# ── 6. Docker Container Port Mappings ─────────────────────────────────────────
GATEWAY_PORT=80
BACKEND_PORT=5000
ML_PORT=8000
CLASSIFICATION_PORT=8001
STAFF_PORT=8002
PASSENGER_PORT=5173
OFFICER_PORT=5174
STAFF_PORT_UI=5175
MONGO_PORT=27017
TWILIO_VOICE_PORT=6000
TWILIO_WHATSAPP_PORT=6001
